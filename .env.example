# FocusTodo environment variables.
# Copy this file to `.env` (real values) and keep `.env` out of version control.
# Every variable listed here is real and validated at startup in `src/lib/env.ts`.

# PostgreSQL connection string used by Prisma and the application.
# The default docker-compose.yml database uses these exact credentials:
#   user: postgres  password: postgres  database: focustodo  host: localhost:5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/focustodo

# Auth.js cookie-signing secret (required, minimum 32 characters).
# Generate one locally with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
