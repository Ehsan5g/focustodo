// FocusTodo data model (data-model.md, feature 001-project-foundation).
// Deliberately EMPTY: the task model is defined by the tasks feature.
// Migration history starts empty; schema management is migration-based
// (db:migrate / db:deploy), never db push (D8).
//
// Deviation note (tasks.md T023 vs Prisma 7): the spec text assumes the
// Prisma ≤6 idiom (generator prisma-client-js + `url = env("DATABASE_URL")`).
// Prisma 7.10 (pinned per research.md D8) removed datasource `url` from
// schema files — the connection string lives in prisma.config.ts for the CLI
// and a driver adapter feeds PrismaClient (see src/server/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
