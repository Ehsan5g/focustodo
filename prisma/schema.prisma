// FocusTodo data model.
// Feature 001-project-foundation: empty migration-based baseline.
// Feature 002-user-auth (data-model.md): first business models User + Session.
// Schema management is migration-based (db:migrate / db:deploy), never db push (D8).
//
// Deviation note (tasks.md T023 vs Prisma 7): the spec text assumes the
// Prisma ≤6 idiom (generator prisma-client-js + `url = env("DATABASE_URL")`).
// Prisma 7.10 (pinned per research.md D8) removed datasource `url` from
// schema files — the connection string lives in prisma.config.ts for the CLI
// and a driver adapter feeds PrismaClient (see src/server/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A person with an account (data-model.md User). Owns all future private
/// data; `email` is stored normalized (trimmed + lowercased at input) and
/// unique per constitution II. `passwordHash` is scrypt-encoded
/// (`scrypt$N$r$p$<salt-b64>$<hash-b64>`) and never selected into any
/// client payload (research D11).
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  tasks       Task[]
  categories  Category[]

  // Prisma 7's new client generator keeps model names as-is; map to the
  // conventional snake_case table names (matches F001's health_check style).
  @@map("users")
}

/// A signed-in period for exactly one user (data-model.md Session).
/// The opaque `id` is the bearer claim carried inside the Auth.js JWT
/// cookie; `expiresAt` always equals `lastProtectedInteraction + 30 days`
/// (sliding window, clarified FR-011). Deleting the row revokes the
/// session everywhere instantly (multi-tab sign-out, research D2).
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A personal to-do item owned by exactly one user (data-model.md Task,
/// feature 003-task-management; the category link activated additively by
/// feature 004-task-categories). `dueDate` is a PostgreSQL DATE — a calendar
/// day with no time-of-day (research D1). `status` is forward-only after
/// creation (TODO → IN_PROGRESS → COMPLETED; COMPLETED → TODO reopens),
/// enforced by the shared pure `validateTransition` rule (research D2).
/// `category` is the optional single-category link (F004 research D2):
/// deleting a category sets `categoryId` to NULL (onDelete: SetNull) while
/// the task keeps every other field (data-model invariant 6).
model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @db.Date
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The one F003 read pattern — per-user list, newest-first (research D6).
  @@index([userId, createdAt(sort: Desc)])
  // F004: the task-list category-name join (D5) and the SetNull cascade
  // scan on category deletion (D2, D6).
  @@index([categoryId])
  @@map("tasks")
}

/// A named grouping owned by exactly one user (data-model.md Category,
/// feature 004-task-categories). `name` is the entered name after trimming
/// (original case preserved — the only displayed field, 1–60 characters).
/// `nameKey` is the lowercased trimmed name, persisted for the per-user
/// case-insensitive uniqueness AND the alphabetical ordering (research D1);
/// it is an implementation column, never selected into any client-facing
/// payload (data-model invariant 2, DTO rule D9).
model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  nameKey   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  // Per-user case-insensitive uniqueness (D1); the `userId` leftmost prefix
  // serves every per-user lookup — list, picker, ownership resolution (D6).
  @@unique([userId, nameKey])
  @@map("categories")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
